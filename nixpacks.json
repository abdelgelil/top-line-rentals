{
  "providers": ["node"],
  "variables": {
    "NIXPACKS_NODE_VERSION": "24"
  },
  "phases": {
    "setup": {
      "nixPkgs": ["nodejs_24"]
    },
    "install": {
      "cmd": "npm install --include=optional"
    },
    "build": {
      "cmd": "npm run build"
    }
  },
  "start": {
    "cmd": "node server.js"
  }
}
