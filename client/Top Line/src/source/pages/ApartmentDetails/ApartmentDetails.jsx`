import React, { useEffect, useState } from 'react';
import { useParams } from 'react-router-dom';
import { useUser } from '@clerk/clerk-react';
import { fetchApartmentById } from '../../services/api';
import BookingForm from '../../components/booking/BookingForm';
import { 
  Users, 
  Maximize, 
  Building, 
  Bed, 
  Bath, 
  Star, 
  Info, 
  X, 
  ChevronRight,
  CheckCircle2
} from 'lucide-react';

export function ApartmentDetails({ currentUser: propUser }) {
  const { id } = useParams();
  const { user: clerkUser } = useUser();
  const currentUser = propUser || clerkUser;

  const [apartment, setApartment] = useState(null);
  const [loading, setLoading] = useState(true);
  const [mainImage, setMainImage] = useState(null);
  const [isLightboxOpen, setIsLightboxOpen] = useState(false);

  useEffect(() => {
    fetchApartmentById(id)
      .then((res) => {
        const fetchedData = res?.data?.data || res?.data || res;
        if (fetchedData && (fetchedData._id || fetchedData.id)) {
          setApartment(fetchedData);
          setMainImage(fetchedData.images?.[0] || 'https://via.placeholder.com/800x600');
        } else {
          setApartment(null);
        }
        setLoading(false);
      })
      .catch((err) => {
        console.error('Failed to fetch apartment:', err);
        setLoading(false);
      });
  }, [id]);

  if (loading) {
    return (
      <div className="flex flex-col items-center justify-center min-h-[60vh] text-slate-500 space-y-4">
        <div className="w-10 h-10 border-4 border-amber-500 border-t-transparent rounded-full animate-spin" />
        <p className="font-medium">Loading luxury details...</p>
      </div>
    );
  }

  if (!apartment) {
    return (
      <div className="flex flex-col items-center justify-center min-h-[60vh] text-red-500 space-y-4">
        <Info className="w-12 h-12" />
        <p className="text-xl font-semibold">Apartment not found.</p>
      </div>
    );
  }

  const images = apartment.images || [];
  const mainImg = mainImage || images[0] || 'https://via.placeholder.com/800x600';
  const otherImages = images.slice(1);

  return (
    <div className="max-w-7xl mx-auto px-4 py-8 lg:py-12">
      <div className="grid grid-cols-1 lg:grid-cols-3 gap-12">
        
        {/* Left Column: Gallery & Details */}
        <div className="lg:col-span-2 space-y-10">
          
          {/* Interactive Gallery */}
          <div className="grid grid-cols-1 sm:grid-cols-4 gap-4 h-full">
            <div className="sm:col-span-3 relative group overflow-hidden rounded-3xl shadow-lg bg-slate-100 dark:bg-slate-800">
              <img
                src={mainImg}
                alt={apartment.title}
                className="w-full h-[400px] sm:h-[500px] object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </div>
            <div className="sm:col-span-1 grid grid-cols-2 sm:grid-cols-1 gap-4">
              {otherImages.slice(0, 4).map((img, idx) => (
                <div 
                  key={idx} 
                  onClick={() => setMainImage(img)}
                  className="relative h-24 sm:h-full object-cover rounded-2xl overflow-hidden cursor-pointer border-2 border-transparent hover:border-amber-500 transition-all shadow-sm bg-slate-100 dark:bg-slate-800"
                >
                  <img src={img} className="w-full h-full object-cover" alt={`Gallery ${idx}`} />
                </div>
              ))}
              {images.length > 5 && (
                <div 
                  onClick={() => setIsLightboxOpen(true)}
                  className="relative h-24 sm:h-full rounded-2xl overflow-hidden cursor-pointer group shadow-sm bg-slate-100 dark:bg-slate-800"
                >
                  <img src={images[4]} className="w-full h-full object-cover opacity-50" alt="More" />
                  <div className="absolute inset-0 flex items-center justify-center bg-black/40 group-hover:bg-black/50 transition-colors">
                    <span className="text-white font-bold text-sm">+{images.length - 5} More</span>
                  </div>
                </div>
              )}
            </div>
          </div>

          {/* Property Header */}
          <div className="space-y-4">
            <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <h1 className="text-4xl font-black text-slate-900 dark:text-white tracking-tight">
                {apartment.title}
              </h1>
              <div className="flex items-center gap-2 bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400 px-3 py-1 rounded-full text-sm font-bold">
                <Star className="w-4 h-4 fill-current" />
                <span>Premium Listing</span>
              </div>
            </div>

            {/* Feature Badges */}
            <div className="flex flex-wrap gap-3">
              <div className="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 text-xs font-medium">
                <Building className="w-3.5 h-3.5 text-amber-500" /> {apartment.tower || 'Luxury Tower'}
              </div>
              <div className="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 text-xs font-medium">
                <Users className="w-3.5 h-3.5 text-amber-500" /> {apartment.guests || 2} Guests
              </div>
              <div className="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 text-xs font-medium">
                <Maximize className="w-3.5 h-3.5 text-amber-500" /> {apartment.sizeSqM || 'N/A'} m²
              </div>
              <div className="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 text-xs font-medium">
                <Bed className="w-3.5 h-3.5 text-amber-500" /> Luxury Suite
              </div>
            </div>
          </div>

          {/* Description Section */}
          <div className="space-y-6">
            <div className="flex items-center gap-2 text-slate-900 dark:text-white font-bold text-xl">
              <Info className="w-5 h-5 text-amber-500" />
              <h2>Property Overview</h2>
            </div>
            <p className="text-slate-600 dark:text-slate-300 leading-relaxed text-lg">
              {apartment.description}
            </p>
          </div>

          {/* Amenities Grid */}
          <div className="grid grid-cols-1 sm:grid-cols-2 gap-8 pt-6">
            <div className="space-y-4">
              <h3 className="font-bold text-slate-900 dark:text-white flex items-center gap-2">
                <CheckCircle2 className="w-5 h-5 text-amber-500" />
                Building Amenities
              </h3>
              <ul className="grid grid-cols-1 gap-3">
                {['Infinity Pool', 'Fitness Center', '24/7 Concierge', 'Secure Parking'].map((item) => (
                  <li key={item} className="flex items-center gap-3 text-sm text-slate-600 dark:text-slate-400">
                    <div className="w-1.5 h-1.5 rounded-full bg-amber-500" /> {item}
                  </li>
                ))}
              </ul>
            </div>
            <div className="space-y-4">
              <h3 className="font-bold text-slate-900 dark:text-white flex items-center gap-2">
                <CheckCircle2 className="w-5 h-5 text-amber-500" />
                House Rules
              </h3>
              <ul className="grid grid-cols-1 gap-3">
                {['No Smoking Indoors', 'No Parties', 'Check-in after 2PM', 'Quiet hours 10PM-8AM'].map((item) => (
                  <li key={item} className="flex items-center gap-3 text-sm text-slate-600 dark:text-slate-400">
                    <div className="w-1.5 h-1.5 rounded-full bg-amber-500" /> {item}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>

        {/* Right Column: Booking Sidebar */}
        <div className="lg:col-span-1">
          <div className="sticky top-28">
            <BookingForm apartment={apartment} currentUser={currentUser} />
          </div>
        </div>
      </div>

      {/* Lightbox Modal */}
      {isLightboxOpen && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/90 backdrop-blur-sm p-4 animate-in fade-in duration-300">
          <button 
            onClick={() => setIsLightboxOpen(false)}
            className="absolute top-6 right-6 p-2 rounded-full bg-white/10 text-white hover:bg-white/20 transition-colors"
          >
            <X className="w-6 h-6" />
          </button>
          <div className="max-w-5xl w-full grid grid-cols-1 sm:grid-cols-3 gap-4">
            {images.map((img, idx) => (
              <img 
                key={idx} 
                src={img} 
                className="w-full h-64 object-cover rounded-2xl border border-white/10" 
                alt={`Full view ${idx}`} 
              />
            ))}
          </div>
        </div>
      )}
    </div>
  );
}

export default ApartmentDetails;
