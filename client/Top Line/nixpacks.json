{
  "providers": ["node"],
  "variables": {
    "NIXPACKS_NODE_VERSION": "20"
  },
  "phases": {
    "setup": {
      "nixPkgs": ["nodejs_20"]
    },
    "install": {
      "cmd": "npm install"
    },
    "build": {
      "cmd": "npm run build"
    }
  },
  "static": {
    "directory": "dist"
  }
}
