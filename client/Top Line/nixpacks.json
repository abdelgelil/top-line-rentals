{
  "providers": ["node"],
  "variables": {
    "NIXPACKS_NODE_VERSION": "24"
  },
  "phases": {
    "setup": {
      "nixPkgs": ["nodejs_24"]
    },
    "install": {
      "cmd": "cd \"client/Top Line\" && npm install --include=optional --no-save"
    },
    "build": {
      "cmd": "cd \"client/Top Line\" && npm run build"
    }
  },
  "start": {
    "cmd": "cd \"client/Top Line\" && npm start"
  }
}
